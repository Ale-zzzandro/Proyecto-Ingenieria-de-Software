# Copiar este archivo como backend/.env y ajustar los valores locales.
# NUNCA compartas ni publiques backend/.env ni uses estos valores en producción.

# Flask
FLASK_ENV=development
FLASK_DEBUG=1

# Seguridad (obligatorias: el backend no arranca si faltan)
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_SECRET_KEY=cambia-esta-otra-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRACION_HORAS=8

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_local
DB_NAME=sistema_incidencias

# CORS (orígenes separados por coma; Live Server suele usar el puerto 5500)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
